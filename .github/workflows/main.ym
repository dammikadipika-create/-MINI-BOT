name: NIKKA X MD - Private Plugins Workflow

on:
  push:
    branches:
      - main

  pull_request:
    branches:
      - main

  workflow_dispatch:

jobs:
  build:
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:
      # 1. Checkout Main Repository
      - name: Checkout Main Repository
        uses: actions/checkout@v4

      # 2. Setup Node.js
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20.x

      # 3. Checkout Private Plugins Repository
      - name: Checkout Private Plugins
        uses: actions/checkout@v4
        with:
          repository: dammikadipika-create/NIKKA---X-MD
          token: ${{ secrets.NIKKA_PLUGINS_TOKEN }}
          path: private-plugins

      # 4. Fix ASN1 Dependencies
      - name: Fix ASN1 Dependencies
        run: |
          npm pkg set 'overrides.@peculiar/asn1-schema=2.11.0'
          npm pkg set 'overrides.@peculiar/asn1-x509=2.11.0'

      # 5. Install Dependencies
      - name: Install Dependencies
        run: npm install --legacy-peer-deps

      # 6. Install FFmpeg and ImageMagick
      - name: Install FFmpeg & ImageMagick
        run: |
          sudo rm -rf /var/lib/apt/lists/*
          sudo apt-get clean
          sudo apt-get update -o Acquire::Retries=5
          sudo apt-get install -y --fix-missing ffmpeg imagemagick

      # 7. Check Required Secrets
      - name: Check Required Secrets
        env:
          SESSION_ID: ${{ secrets.SESSION_ID }}
          SASA_API_KEY: ${{ secrets.SASA_API_KEY }}
          SASA_DEV_API_KEY: ${{ secrets.SASA_DEV_API_KEY }}
          SASA_TTS_API_KEY: ${{ secrets.SASA_TTS_API_KEY }}
          IMGBB_API_KEY: ${{ secrets.IMGBB_API_KEY }}
        run: |
          if [ -z "$SESSION_ID" ]; then
            echo "SESSION_ID is missing"
            exit 1
          fi

          if [ -z "$SASA_API_KEY" ]; then
            echo "SASA_API_KEY is missing"
            exit 1
          fi

          if [ -z "$SASA_DEV_API_KEY" ]; then
            echo "SASA_DEV_API_KEY is missing"
            exit 1
          fi

          if [ -z "$SASA_TTS_API_KEY" ]; then
            echo "SASA_TTS_API_KEY is missing"
            exit 1
          fi

          if [ -z "$IMGBB_API_KEY" ]; then
            echo "IMGBB_API_KEY is missing"
            exit 1
          fi

          echo "All required secrets are configured."

      # 8. Start Application
      - name: Start Application
        env:
          SESSION_ID: ${{ secrets.SESSION_ID }}
          SASA_API_KEY: ${{ secrets.SASA_API_KEY }}
          SASA_DEV_API_KEY: ${{ secrets.SASA_DEV_API_KEY }}
          SASA_TTS_API_KEY: ${{ secrets.SASA_TTS_API_KEY }}
          IMGBB_API_KEY: ${{ secrets.IMGBB_API_KEY }}
        run: node index.js
