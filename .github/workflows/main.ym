name: NIKKA X MD - Private Plugins Workflow

on:
  push:
    branches:
      - main

  pull_request:
    branches:
      - main

  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:
      - name: Checkout Main Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20.x

      - name: Check Private Repository Token
        env:
          PLUGINS_TOKEN: ${{ secrets.NIKKA_PLUGINS_TOKEN }}
        run: |
          if [ -z "$PLUGINS_TOKEN" ]; then
            echo "NIKKA_PLUGINS_TOKEN is missing!"
            exit 1
          fi
          echo "Private repository token detected."

      - name: Checkout Private Plugins
        uses: actions/checkout@v4
        with:
          repository: dammikadipika-create/NIKKA---X-MD
          token: ${{ secrets.NIKKA_PLUGINS_TOKEN }}
          path: private-plugins
          persist-credentials: false

      - name: Install Private Plugins
        run: |
          if [ ! -d "private-plugins/plugins" ]; then
            echo "Private plugins/plugins folder not found!"
            exit 1
          fi

          mkdir -p plugins
          cp -a private-plugins/plugins/. plugins/

          if ! find plugins -maxdepth 1 -type f -name "*.js" | grep -q .; then
            echo "No JavaScript plugin files found!"
            exit 1
          fi

          echo "Private plugins copied successfully!"
          ls -la plugins/

      - name: Fix ASN1 Dependencies
        run: |
          npm pkg set 'overrides.@peculiar/asn1-schema=2.11.0'
          npm pkg set 'overrides.@peculiar/asn1-x509=2.11.0'

      - name: Install Dependencies
        run: npm install --legacy-peer-deps

      - name: Install FFmpeg and ImageMagick
        run: |
          sudo apt-get update -o Acquire::Retries=5
          sudo apt-get install -y --fix-missing ffmpeg imagemagick

      - name: Check Required Secrets
        env:
          SESSION_ID: ${{ secrets.SESSION_ID }}
          SASA_API_KEY: ${{ secrets.SASA_API_KEY }}
          SASA_DEV_API_KEY: ${{ secrets.SASA_DEV_API_KEY }}
          SASA_TTS_API_KEY: ${{ secrets.SASA_TTS_API_KEY }}
          IMGBB_API_KEY: ${{ secrets.IMGBB_API_KEY }}
        run: |
          for key in SESSION_ID SASA_API_KEY SASA_DEV_API_KEY SASA_TTS_API_KEY IMGBB_API_KEY; do
            if [ -z "${!key}" ]; then
              echo "$key is missing"
              exit 1
            fi
          done

          echo "All required secrets are configured."

      - name: Start Application
        env:
          SESSION_ID: ${{ secrets.SESSION_ID }}
          SASA_API_KEY: ${{ secrets.SASA_API_KEY }}
          SASA_DEV_API_KEY: ${{ secrets.SASA_DEV_API_KEY }}
          SASA_TTS_API_KEY: ${{ secrets.SASA_TTS_API_KEY }}
          IMGBB_API_KEY: ${{ secrets.IMGBB_API_KEY }}
        run: node index.js
